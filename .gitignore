# Claude Code local state — may contain credentials or machine-specific paths.
# The spec-kit skills under .claude/skills/ are intentionally tracked.
.claude/settings.local.json
.claude/local/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS / editor noise
.DS_Store
*.swp
# Squad: ignore runtime state (logs, inbox, sessions)
# Note: .squad/casting/* is identity and MUST be committed to main, not ignored
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.cache/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream
